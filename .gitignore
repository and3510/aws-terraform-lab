# Diretórios locais do Terraform
**/.terraform/*

# State (contém segredos e a estrutura da infra)
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Planos salvos
*.tfplan
tfplan

# Variáveis locais (os *.example são versionados)
*.tfvars
*.tfvars.json
!*.tfvars.example

# Logs de crash e overrides locais
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Chaves
*.pem

# Lock file só faz sentido em root modules
**/modules/**/.terraform.lock.hcl
